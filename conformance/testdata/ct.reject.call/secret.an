// want: ct.reject.call

package main

import "an/meta"

type Secret struct {
	v string
}

func query(args ...any) int {
	for const a := range args {
		switch a.(type) {
		case Secret:
			meta.Reject("query: pass secrets explicitly")
		default:
		}
	}
	return len(args)
}

func main() {
	_ = query(1, "x")
	_ = query(Secret{"pw"})
}
