// want: eff.profile.allowed
// checks: mem.inout.unique

// A slice variable may share its buffer, so passing it inout may copy:
// in the profile core that is an allocation.
package main

profile core

func fill(xs inout []int, v int) {
	for i := range xs {
		xs[i] = v
	}
}

func main() {
	var a [4]int
	fill(a[1:3], 7)
	s := a[:]
	fill(s, 7)
}
