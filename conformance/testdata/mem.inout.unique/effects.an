// want: ok
// checks: eff.source.alloc-ops

// Writes through a unique slice copy nothing; a slice that may share its
// buffer is made unique when it is passed inout or assigned to an inout
// parameter.
package main

// effects: fill Panic
func fill(xs inout []int, v int) {
	for i := range xs {
		xs[i] = v
	}
}

// effects: head Panic
func head(xs inout []int) {
	if len(xs) > 1 {
		fill(xs[:1], 0)
		copy(xs[1:], xs[:1])
		clear(xs[1:])
	}
}

// effects: array Panic
func array() [4]int {
	var a [4]int
	fill(a[1:3], 7)
	head(a[:])
	return a
}

// effects: shared Alloc Panic
func shared(s []int) {
	fill(s, 7)
}

// effects: local Alloc Panic
func local(xs inout []int) {
	ys := xs
	ys[0] = 1
}

// effects: copied Alloc Panic
func copied(xs inout []int) int {
	ys := xs
	xs[0] = 1
	return ys[0]
}

// effects: captured Alloc Panic
func captured(xs inout []int) int {
	f := func() int { return xs[0] }
	xs[0] = 1
	return f()
}

// effects: valueRange Alloc Panic
func valueRange(xs inout []int) {
	for i, x := range xs {
		xs[i] = x + 1
	}
}

// effects: keyRange Panic
func keyRange(xs inout []int) {
	for i := range xs {
		xs[i] = len(xs)
	}
}

// effects: assign Alloc Panic
func assign(xs inout []int, ys []int) {
	xs = ys
}

// effects: reslice Panic
func reslice(xs inout []int) {
	xs = xs[:0]
}

// effects: copyShared Alloc
func copyShared(s []int, t []int) {
	copy(s, t)
}

func main() {
	_ = array()
	shared(nil)
	var a [2]int
	local(a[:])
	assign(a[:], nil)
	reslice(a[:])
	_ = copied(a[:])
	_ = captured(a[:])
	valueRange(a[:])
	keyRange(a[:])
	copyShared(nil, nil)
}
