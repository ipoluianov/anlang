// want: ok

// Run-time checks: those of the loops are proven and removed, the one of
// the last index stays and fails (contract.check.runtime).
package main

profile core

import "an/fmt"

func main() {
	var a [8]u8
	for i := range 8 {
		a[i] = u8(i * 3)
	}
	s := 0
	for i := 0; i < len(a); i++ {
		s += int(a[i])
	}
	for i := len(a) - 1; i >= 0; i-- {
		s -= int(a[i]) / 2
	}
	fmt.Println(s)
	k := s % 16
	fmt.Println(a[k])
}
