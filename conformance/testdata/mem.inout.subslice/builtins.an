// want: ok
// checks: mem.inout.builtin

// copy and clear take an inout access to their first operand: a
// subslice of an array denotes its elements, which they change.
package main

import "an/fmt"

func main() {
	xs := [3]int{1, 2, 3}
	ys := [3]int{4, 5, 6}
	copy(ys[1:], xs[:])
	zs := [3]int{7, 8, 9}
	clear(zs[:2])
	fmt.Println(ys[0], ys[1], ys[2], zs[0], zs[1], zs[2])
}
