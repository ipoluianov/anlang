// want: ok

// Floating-point arithmetic, comparisons, conversions and printing in the
// core profile: on targets without floating-point hardware the results
// are the same as with it (type.float.target).
package main

profile core

import "an/fmt"

// harmonic returns 1 + 1/2 + … + 1/n.
func harmonic(n int) f64 {
	s := 0.0
	for i := 1; i <= n; i++ {
		s += 1 / f64(i)
	}
	return s
}

// sqrt returns the square root of x by Newton's method.
func sqrt(x f64) f64 {
	if x == 0 {
		return 0
	}
	r := x
	for range 25 {
		r = (r + x/r) / 2
	}
	return r
}

func main() {
	// Arithmetic and printing of f64.
	fmt.Println(0.1+0.2, 1.0/3, 2.0/3, 1e21, 1e20, 123456.0, 1234567.0)
	fmt.Println(harmonic(10), harmonic(20), sqrt(2), sqrt(1e10))
	x := 1.0
	for range 30 {
		x *= 1.7
	}
	fmt.Println(x, -x, x/1e60, 1/x)
	tiny := 1e-300
	fmt.Println(tiny*1e-10, tiny*1e-24, tiny*1e-30, tiny*tiny)
	big := 1e300
	fmt.Println(big*10, big*big, -big*big, 0*(big*big))
	var zero f64
	neg := -zero
	fmt.Println(zero, neg, 1/zero, -1/zero, zero/zero)

	// Comparisons, with NaN and signed zeros.
	nan := zero / zero
	fmt.Println(nan == nan, nan != nan, nan < 1, nan >= 1, zero == neg, 1.5 < 2.5, 2.5 <= 2.5, -1.0 > -2.0)
	fmt.Println(min(3.5, -2.0, 7.25), max(3.5, -2.0, 7.25), min(zero, neg), max(neg, zero))

	// f32: arithmetic rounded to single precision.
	var a f32 = 0.1
	var b f32 = 0.2
	fmt.Println(a+b, a*b, a/b, f32(1)/3, f64(a))
	var s f32
	for i := 1; i <= 100; i++ {
		s += f32(i) * 0.01
	}
	var huge f32 = 1e38
	fmt.Println(s, f32(16777217), huge*10)

	// Conversions between integers and floats.
	p, q, r := 3.99, 1e18, 255.9
	fmt.Println(int(p), int(-p), i64(q), u8(r), f64(i64(-9007199254740993)), f64(u64(18446744073709551615)))
	fmt.Println(f32(i32(16777217)), f64(-7)/2, i16(f32(-32768)))

	// fmt.Printf verbs, precisions, widths and flags.
	fmt.Printf("%f %.2f %.0f %e %.3e %E %g %.3g %G\n", 3.14159, 3.14159, 2.5, 123456.789, 0.000123456, 1e-10, 1e-5, 1234.5678, 1e100)
	fmt.Printf("[%8.3f] [%-8.3f] [%+.2f] [% .2f] [%08.3f] [%+08.2f] [%10.2e]\n", 3.14159, 3.14159, 2.0, 2.0, -3.14159, 3.0, 12345.678)
	fmt.Printf("%v %v %.1f %f %8.2f %g\n", 1e6, 1e-7, 0.05, 1e20, nan, -1/zero)
	fmt.Printf("%.20f %.17g %g %g\n", 0.1, 0.1, f32(0.1), 100000.0)
	println(3.25, -1e-7, big*1e10, zero)
}
