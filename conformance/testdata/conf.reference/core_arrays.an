// want: ok

// Arrays, structs, slices of arrays and strings in the core profile.
package main

profile core

import "an/fmt"

type Rect struct {
	Min, Max [2]i16
	Name     string
}

func sum(xs []int) int {
	t := 0
	for _, x := range xs {
		t += x
	}
	return t
}

func area(r Rect) i32 {
	return i32(r.Max[0]-r.Min[0]) * i32(r.Max[1]-r.Min[1])
}

const table = [4]u16{1, 10, 100, 1000}

const greeting = "héllo, wörld"

func main() {
	var a [6]int
	for i := range a {
		a[i] = i * i
	}
	fmt.Println(a, len(a), sum(a[:]), sum(a[2:5]), a[1:3])
	b := a
	b[0] = 99
	fmt.Println(a[0], b[0], a == b, a != b)
	r := Rect{Min: [2]i16{-5, 2}, Max: [2]i16{10, 20}, Name: "box"}
	fmt.Println(r, area(r))
	r2 := r
	r2.Max[1] = 3
	fmt.Println(r == r2, area(r2), r2.Name)
	for i, t := range table {
		fmt.Print(i, ":", t, " ")
	}
	fmt.Println()
	s := greeting
	fmt.Println(len(s), s[1], s[:5], s[7:], s[2:4] == "\xa9l")
	for i, c := range s {
		if c > 127 {
			fmt.Println(i, c)
		}
	}
	fmt.Println("abc" < "abd", "abc" < "ab", "b" > "abc", s == "héllo, wörld", s != greeting)
	var grid [3][4]u8
	for i := range 3 {
		for j := range 4 {
			grid[i][j] = u8(i)*4 + u8(j)
		}
	}
	fmt.Println(grid, grid[2][3])
	row := grid[1]
	t := 0
	for _, v := range row[1:] {
		t += int(v)
	}
	fmt.Println(t)
}
