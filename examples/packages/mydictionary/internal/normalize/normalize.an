// Package normalize turns user input into dictionary keys.
//
// The package is internal: only packages under myprogram/mydictionary
// may import it. Importing it from package main is a compile error.
package normalize

import "an/strings"

// Word trims surrounding white space and converts w to lower case.
func Word(w string) string {
	return strings.ToLower(strings.TrimSpace(w))
}
