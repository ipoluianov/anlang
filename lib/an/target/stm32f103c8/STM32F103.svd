                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Processor</name>
                  <description>the processor clock</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>COUNTFLAG</name>
