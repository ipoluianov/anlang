// Package atomic provides values that the main program, interrupt
// handlers and tasks share (spec/09-concurrency.md §9.7): each operation
// is indivisible. On the single-core targets of the core profile an
// operation runs with the interrupts disabled.
//
// Until the handles of synchronization types (conc.sync.handle), atomic
// values are package-level variables, and their methods take them as
// inout receivers.
package atomic

profile core, app, ui

import (
	"an/runtime"
	"an/wrap"
)

// U8 is an atomic u8.
type U8 struct {
	v u8
}

// Load returns the value.
func (a inout U8) Load() u8 {
	s := runtime.DisableInterrupts()
	v := a.v
	runtime.RestoreInterrupts(s)
	return v
}

// Store sets the value to v.
func (a inout U8) Store(v u8) {
	s := runtime.DisableInterrupts()
	a.v = v
	runtime.RestoreInterrupts(s)
}

// Add adds d to the value, wrapping around, and returns the new value.
func (a inout U8) Add(d u8) u8 {
	s := runtime.DisableInterrupts()
	a.v = u8(wrap.U8(a.v) + wrap.U8(d))
	v := a.v
	runtime.RestoreInterrupts(s)
	return v
}

// Swap sets the value to v and returns the old value.
func (a inout U8) Swap(v u8) u8 {
	s := runtime.DisableInterrupts()
	old := a.v
	a.v = v
	runtime.RestoreInterrupts(s)
	return old
}

// CompareAndSwap sets the value to new if it is old, and reports whether
// it did.
func (a inout U8) CompareAndSwap(old, new u8) bool {
	s := runtime.DisableInterrupts()
	ok := a.v == old
	if ok {
		a.v = new
	}
	runtime.RestoreInterrupts(s)
	return ok
}

