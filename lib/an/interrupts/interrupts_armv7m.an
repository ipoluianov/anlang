// Package interrupts controls the interrupts of a microcontroller
// (spec/14-embedded.md §2.5): main starts with them disabled, and
// Enable, called only directly from main, ends its initialization phase.
package interrupts

profile core

import "an/arch/armv7m"

// Enable enables the interrupts.
func Enable() {
	armv7m.Cpsie(armv7m.Regs{})
}
