	{Op: "eq", Width: 64, Code: "LDR R0, {x.0}\nLDR R1, {x.1}\nLDR R2, {y.0}\nLDR R3, {y.1}\nMOV R12, 0\nCMP R0, R2\nBNE @f\nCMP R1, R3\nBNE @f\nMOV R12, 1\n@f:\nSTRB R12, {r}"},
	{Op: "ne", Width: 64, Code: "LDR R0, {x.0}\nLDR R1, {x.1}\nLDR R2, {y.0}\nLDR R3, {y.1}\nMOV R12, 1\nCMP R0, R2\nBNE @f\nCMP R1, R3\nBNE @f\nMOV R12, 0\n@f:\nSTRB R12, {r}"},
