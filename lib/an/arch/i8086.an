	Semantics: `// The segment of an address: the segment register d, unless a prefix
// overrides it.
fn seg(d) {
	if SEGOV {
		return SEG;
	}
	return d;
}

// The physical address of offset off in segment s.
fn linear(s, off) {
	return (zx(s, 20) << 4) + zx(off, 20);
}

// A word at offset off of segment s: its high byte is at off + 1 within
// the segment, which wraps around at the end of the segment.
fn rd16(s, off) {
	return zx(mem8[linear(s, off)], 16) | zx(mem8[linear(s, off + 1)], 16) << 8;
}

fn wr16(s, off, v) {
	mem8[linear(s, off)] = v[7:0];
	mem8[linear(s, off + 1)] = v[15:8];
}

fn push16(v) {
	SP = SP - 2;
	wr16(SS, SP, v);
}

fn pop16() {
	let v = rd16(SS, SP);
	SP = SP + 2;
	return v;
}

// The interrupt sequence: the flags, CS and IP are pushed, interrupts
// and single-stepping are disabled, and the vector of interrupt n in the
// table at address 0 is loaded.
fn interrupt(n) {
	push16(FLAGS);
	IF = 0;
	TF = 0;
	push16(CS);
	push16(IP);
	let v = zx(n, 16) << 2;
	IP = rd16(0, v);
	CS = rd16(0, v + 2);
}

fn parity(x) {
	let p = x ^ (x >> 4);
	p = p ^ (p >> 2);
	p = p ^ (p >> 1);
	return !p[0];
}

fn szp(r) {
	ZF = r == 0;
	SF = msb(r);
	PF = parity(tr(r, 8));
}

fn add(x, y, c) {
	let n = width(x) + 1;
	let wide = zx(x, n) + zx(y, n) + zx(c, n);
	let r = tr(wide, width(x));
	CF = wide[width(x)];
	OF = msb((x ^ r) & (y ^ r));
	AF = (x ^ y ^ r)[4];
	szp(r);
	return r;
}

fn sub(x, y, c) {
	let n = width(x) + 1;
	let wide = zx(x, n) - zx(y, n) - zx(c, n);
	let r = tr(wide, width(x));
	CF = wide[width(x)];
	OF = msb((x ^ y) & (x ^ r));
	AF = (x ^ y ^ r)[4];
	szp(r);
	return r;
}

fn logic(r) {
	CF = 0;
	OF = 0;
	AF = 0;
	szp(r);
	return r;
}

fn inc(x) {
	let c = CF;
	let r = add(x, zx(1, width(x)), 0);
	CF = c;
	return r;
}

fn dec(x) {
	let c = CF;
	let r = sub(x, zx(1, width(x)), 0);
	CF = c;
	return r;
}

fn neg(x) {
	let r = sub(zx(0, width(x)), x, 0);
	CF = x != 0;
	return r;
}

// Shifts and rotations by n, one bit at a time; the 8086 does not mask
// the count. OF is set as for a count of 1.
fn rol(x, n) {
	let r = x;
	let k = n;
	while k != 0 {
		CF = msb(r);
		r = (r << 1) | zx(CF, width(r));
		k = k - 1;
	}
	if n != 0 {
		OF = msb(r) ^ CF;
	}
	return r;
}

fn ror(x, n) {
	let r = x;
	let k = n;
	while k != 0 {
		CF = r[0];
		r = (r >> 1) | (zx(CF, width(r)) << (width(r) - 1));
		k = k - 1;
	}
	if n != 0 {
		OF = msb(r) ^ r[width(r) - 2];
	}
	return r;
}

fn rcl(x, n) {
	let r = x;
	let k = n;
	while k != 0 {
		let c = CF;
		CF = msb(r);
		r = (r << 1) | zx(c, width(r));
		k = k - 1;
	}
	if n != 0 {
		OF = msb(r) ^ CF;
	}
	return r;
}

fn rcr(x, n) {
	let r = x;
	let k = n;
	if n != 0 {
		OF = msb(r) ^ CF;
	}
	while k != 0 {
		let c = CF;
		CF = r[0];
		r = (r >> 1) | (zx(c, width(r)) << (width(r) - 1));
		k = k - 1;
	}
	return r;
}

fn shl(x, n) {
	if n == 0 {
		return x;
	}
	let r = x;
	let k = n;
	while k != 0 {
		CF = msb(r);
		r = r << 1;
		k = k - 1;
	}
	OF = msb(r) ^ CF;
	szp(r);
	return r;
}

fn shr(x, n) {
	if n == 0 {
		return x;
	}
	let r = x;
	let k = n;
	OF = msb(x);
	while k != 0 {
		CF = r[0];
		r = r >> 1;
		k = k - 1;
	}
	szp(r);
	return r;
}

fn sar(x, n) {
	if n == 0 {
		return x;
	}
	let r = x;
	let k = n;
	while k != 0 {
		CF = r[0];
		r = r >>> 1;
		k = k - 1;
	}
	OF = 0;
	szp(r);
	return r;
}

fn mul(x) {
	if width(x) == 8 {
		AX = zx(AL, 16) * zx(x, 16);
		CF = AH != 0;
	} else {
		let p = zx(AX, 32) * zx(x, 32);
		DX = p[31:16];
		AX = p[15:0];
		CF = DX != 0;
	}
	OF = CF;
}

fn imul(x) {
	if width(x) == 8 {
		AX = sx(AL, 16) * sx(x, 16);
		CF = AX != sx(AL, 16);
	} else {
		let p = sx(AX, 32) * sx(x, 32);
		DX = p[31:16];
		AX = p[15:0];
		CF = p != sx(AX, 32);
	}
	OF = CF;
}

// Division; a zero divisor or a quotient that does not fit raises
// interrupt 0. The signed quotient of the 8086 lies in -127 to 127 (or
// -32767 to 32767), and a REP prefix negates it.
fn div(x) {
	if x == 0 {
		interrupt(0);
		return;
	}
	if width(x) == 8 {
		let q = divu(AX, zx(x, 16));
		if q > 0xFF {
			interrupt(0);
			return;
		}
		AH = tr(remu(AX, zx(x, 16)), 8);
		AL = tr(q, 8);
	} else {
		let d = (zx(DX, 32) << 16) | zx(AX, 32);
		let q = divu(d, zx(x, 32));
		if q > 0xFFFF {
			interrupt(0);
			return;
		}
		DX = tr(remu(d, zx(x, 32)), 16);
		AX = tr(q, 16);
	}
}

fn idiv(x) {
	if x == 0 {
		interrupt(0);
		return;
	}
	if width(x) == 8 {
		let q = divs(AX, sx(x, 16));
		if REP != 0 {
			q = zx(0, 16) - q;
		}
		if lts(q, 0xFF81) || gts(q, 0x7F) {
			interrupt(0);
			return;
		}
		AH = tr(rems(AX, sx(x, 16)), 8);
		AL = tr(q, 8);
	} else {
		let d = (zx(DX, 32) << 16) | zx(AX, 32);
		let q = divs(d, sx(x, 32));
		if REP != 0 {
			q = zx(0, 32) - q;
		}
		if lts(q, 0xFFFF8001) || gts(q, 0x7FFF) {
			interrupt(0);
			return;
		}
		DX = tr(rems(d, sx(x, 32)), 16);
		AX = tr(q, 16);
	}
}

// Decimal adjustments.
// The 8086 compares the old AL with 9F rather than 99 when AF is set.
fn daa() {
	let old = AL;
	let c = CF;
	let limit = zx(0x99, 8);
	if AF {
		limit = 0x9F;
	}
	if (AL & 0x0F) > 9 || AF {
		AL = AL + 6;
		AF = 1;
	} else {
		AF = 0;
	}
	if old > limit || c {
		AL = AL + 0x60;
		CF = 1;
	} else {
		CF = 0;
	}
	szp(AL);
}

fn das() {
	let old = AL;
	let c = CF;
	let limit = zx(0x99, 8);
	if AF {
		limit = 0x9F;
	}
	if (AL & 0x0F) > 9 || AF {
		AL = AL - 6;
		AF = 1;
	} else {
		AF = 0;
	}
	if old > limit || c {
		AL = AL - 0x60;
		CF = 1;
	} else {
		CF = 0;
	}
	szp(AL);
}

// On the 8086, AAA adds 6 to AL and 1 to AH separately.
fn aaa() {
	if (AL & 0x0F) > 9 || AF {
		AL = AL + 6;
		AH = AH + 1;
		AF = 1;
		CF = 1;
	} else {
		AF = 0;
		CF = 0;
	}
	AL = AL & 0x0F;
}

fn aas() {
	if (AL & 0x0F) > 9 || AF {
		AL = AL - 6;
		AH = AH - 1;
		AF = 1;
		CF = 1;
	} else {
		AF = 0;
		CF = 0;
	}
	AL = AL & 0x0F;
}

fn aam(base) {
	if base == 0 {
		// The flags are set as for a result of 0 before the interrupt.
		CF = 0;
		OF = 0;
		AF = 0;
		szp(zx(0, 8));
		interrupt(0);
		return;
	}
	let t = AL;
	AH = tr(divu(t, base), 8);
	AL = tr(remu(t, base), 8);
	szp(AL);
}

fn aad(base) {
	AL = tr(zx(AL, 16) + zx(AH, 16) * zx(base, 16), 8);
	AH = 0;
	szp(AL);
}

// One step of the string instructions; SI and DI move by the operand
// size, down if DF is set.
fn step(n) {
	if DF {
		return zx(0, 16) - n;
	}
	return zx(n, 16);
}

fn movs8() {
	mem8[linear(ES, DI)] = mem8[linear(seg(DS), SI)];
	SI = SI + step(1);
	DI = DI + step(1);
}

fn movs16() {
	wr16(ES, DI, rd16(seg(DS), SI));
	SI = SI + step(2);
	DI = DI + step(2);
}

fn cmps8() {
	let r = sub(mem8[linear(seg(DS), SI)], mem8[linear(ES, DI)], 0);
	SI = SI + step(1);
	DI = DI + step(1);
}

fn cmps16() {
	let r = sub(rd16(seg(DS), SI), rd16(ES, DI), 0);
	SI = SI + step(2);
	DI = DI + step(2);
}

fn stos8() {
	mem8[linear(ES, DI)] = AL;
	DI = DI + step(1);
}

fn stos16() {
	wr16(ES, DI, AX);
	DI = DI + step(2);
}

fn lods8() {
	AL = mem8[linear(seg(DS), SI)];
	SI = SI + step(1);
}

fn lods16() {
	AX = rd16(seg(DS), SI);
	SI = SI + step(2);
}

fn scas8() {
	let r = sub(AL, mem8[linear(ES, DI)], 0);
	DI = DI + step(1);
}

fn scas16() {
	let r = sub(AX, rd16(ES, DI), 0);
	DI = DI + step(2);
}
`,
	ABI:   ABI{Frame: "BP", Params: 4, Align: 2, Reserved: []string{"SP", "BP", "CS", "DS", "ES", "SS"}, Flags: "FLAGS"},
	Rules: i8086Rules,
}
