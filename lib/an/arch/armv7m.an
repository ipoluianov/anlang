	Semantics: `// The negative and zero flags of a result.
fn nz(r) {
	N = msb(r);
	Z = r == 0;
}

// x + y + c with the flags: AddWithCarry of the ARM manual.
fn adds(x, y, c) {
	let wide = zx(x, 33) + zx(y, 33) + zx(c, 33);
	let r = tr(wide, 32);
	C = wide[32];
	V = msb((x ^ r) & (y ^ r));
	nz(r);
	return r;
}

// The count of a shift by an immediate: 0 encodes 32.
fn count(v) {
	return zx(v, 6) | zx(v == 0, 6) << 5;
}

// x rotated right by n bits, n below 32.
fn ror(x, n) {
	return (x >> n) | (x << (32 - zx(n, 8)));
}

// Shifts with the carry out, by n of any width; a count of 0 keeps C.
fn lslc(x, n) {
	let k = zx(n, 8);
	if k == 0 {
		return x;
	}
	if k <= 32 {
		C = (x >> (32 - k))[0];
	} else {
		C = 0;
	}
	return x << k;
}

fn lsrc(x, n) {
	let k = zx(n, 8);
	if k == 0 {
		return x;
	}
	if k <= 32 {
		C = (x >> (k - 1))[0];
	} else {
		C = 0;
	}
	return x >> k;
}

fn asrc(x, n) {
	let k = zx(n, 8);
	if k == 0 {
		return x;
	}
	if k <= 32 {
		C = (x >> (k - 1))[0];
	} else {
		C = msb(x);
	}
	return x >>> k;
}

fn rorc(x, n) {
	let k = zx(n, 8);
	if k == 0 {
		return x;
	}
	let r = ror(x, k[4:0]);
	C = msb(r);
	return r;
}

fn rrxc(x) {
	let r = (x >> 1) | (zx(C, 32) << 31);
	C = x[0];
	return r;
}

// The value of a modified immediate: ThumbExpandImm of the ARM manual.
fn expand(v) {
	let k = zx(v[7:0], 32);
	if v[11:10] == 0 {
		if v[9:8] == 0 {
			return k;
		}
		if v[9:8] == 1 {
			return k | k << 16;
		}
		if v[9:8] == 2 {
			return k << 8 | k << 24;
		}
		return k | k << 8 | k << 16 | k << 24;
	}
	return ror(zx(v[6:0], 32) | 0x80, v[11:7]);
}

// The value of a modified immediate with the carry out of a rotation.
fn expandc(v) {
	let r = expand(v);
	if v[11:10] != 0 {
		C = msb(r);
	}
	return r;
}

fn popcount(x) {
	let n = zx(0, 32);
	let k = x;
	while k != 0 {
		n = n + zx(k[0], 32);
		k = k >> 1;
	}
	return n;
}

fn clz(x) {
	let n = zx(0, 32);
	let k = x;
	while k != 0 {
		n = n + 1;
		k = k >> 1;
	}
	return 32 - n;
}

fn rbit(x) {
	let r = zx(0, 32);
	let k = x;
	let i = zx(0, 6);
	while i != 32 {
		r = r << 1 | zx(k[0], 32);
		k = k >> 1;
		i = i + 1;
	}
	return r;
}

fn rev(x) {
	return zx(x[7:0], 32) << 24 | zx(x[15:8], 32) << 16 | zx(x[23:16], 32) << 8 | zx(x[31:24], 32);
}

fn rev16(x) {
	return zx(x[23:16], 32) << 24 | zx(x[31:24], 32) << 16 | zx(x[7:0], 32) << 8 | zx(x[15:8], 32);
}

fn revsh(x) {
	return sx(zx(x[7:0], 16) << 8 | zx(x[15:8], 16), 32);
}
`,
